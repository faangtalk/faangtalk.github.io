{
  "name": "hugo-boilerplate-podcast",
  "private": true,
  "config": {
    "postcss": "--use postcss-import --use autoprefixer --use cssnano"
  },
  "scripts": {
    "start": "npm run build -- --watch & hugo server",
    "build": "postcss $npm_package_config_postcss --output docs/css/app.css static/css/app.css",
    "lint": "stylelint static/css/*.css"
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "import-notation": "string",
      "property-no-deprecated": null,
      "value-keyword-case": null,
      "selector-class-pattern": null
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1"
  }
}
